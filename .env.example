# ---- Server (server/) ----
# Postgres connection string (Render provides this; local default matches docker-compose)
DATABASE_URL=postgres://mercatus:mercatus@localhost:5432/mercatus

# JWT signing secret (Render blueprint auto-generates)
JWT_SECRET=change-me

# Seeded admin account (used once, then teams register themselves)
ADMIN_EMAIL=admin@mercatus.tech
ADMIN_PASSWORD=admin1234

# CORS allowlist for the portal (Vercel URL)
CORS_ORIGIN=*

# Gate self-service registration (required in production)
REGISTRATION_CODE=change-me

# Rate limit store: "postgres" (shared, default) or "memory" (single instance)
RATE_LIMIT_STORE=postgres

# Engine tuning
PORT=8080
TICK_INTERVAL_MS=1000
MAX_ROWS_PER_TICK=5000
PG_POOL_SIZE=20

# ---- Web (web/) ----
# Render API base + WebSocket URL (set these on Vercel)
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
